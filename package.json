{
  "name": "examplayer-bot",
  "version": "1.0.0",
  "description": "Advanced Serverless Telegram Quiz & Exam Bot powered by grammY, Cloudflare Workers and Supabase",
  "main": "src/worker.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx src/local.ts",
    "portal": "cd portal && flutter run -d chrome",
    "portal:preview": "cd portal && node serve.js",
    "portal:build": "cd portal && flutter build web --release",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "telegram-bot",
    "quiz-bot",
    "exam-bot",
    "grammy",
    "cloudflare-workers",
    "supabase"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "pdfkit": "^0.20.2",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.9",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^5.8.2",
    "wrangler": "^3.111.0"
  }
}
